generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Template {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  content     Json
  tags        String[]
  formSchema  Json
  documentFamily String?
  requiredPlan String? @default("BASIC")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  drafts Draft[]
}

model Draft {
  id            String   @id @default(uuid())
  userId        String
  templateId    String
  inputData     Json
  generatedText String
  createdAt     DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  template Template @relation(fields: [templateId], references: [id])
}

model Clause {
  id        String   @id @default(uuid())
  title     String   @unique
  family    String
  documents  String[]
  content   String
  keywords  String[]
  premium   Boolean @default(false)
  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  subscription Boolean  @default(false)
  everSubscribed Boolean @default(false)
  subscriptionExpiry  DateTime?
  subscriptionId  String?
  plan String?          
  credits Int @default(0)
  creditResetAt DateTime?
  lastBillingCycleId String?
  createdAt DateTime @default(now())

  drafts Draft[]
}
