            "type": "date",
            "required": true
        },

      {
        "name": "partyOneExecution",
        "label": "Which best describes Party One (Donor)?",
        "type": "select",
        "options": [
          "Individual",
          "Company",
          "Infant",
          "Illiterate",
          "Family Property"
        ],
        "required": true
      },

        {
            "name": "partyOneName",
            "label": "Party One (Donor)'s Legal Name?",
            "type": "text",
        
            "showIf":{
                 "field":"partyOneExecution",
                "equals":[
                  "Individual",
                  "Infant",
                  "Illiterate",
                  "Family Property"
                ] 
            }
        },

        {
            "name": "partyOneOccupation",
