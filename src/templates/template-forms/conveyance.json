{
    "fields": [

      {
        "name": "vendorExecution",
        "label": "Which best describes the Vendor?",
        "type": "select",
        "options": [
          "Individual",
          "Company",
          "Infant",
          "Illiterate",
          "Attorney",
          "Family Property"
        ],
        "required": true
      },

      
      {
        "name": "purchaserExecution",
        "label": "Which best describes the Purchaser?",
        "type": "select",
        "options": [
          "Individual",
          "Company",
          "Infant",
          "Illiterate",
          "Attorney",
          "Family Property"
        ],
        "required": true
      },

        {
            "name": "date",
            "label": "Execution Date?",
            "type": "date",
            "required": "true"
        },

        {
            "name": "vendorName",
            "label": "Vendor's Legal Name?",
            "type": "text",
        
            "showIf":{
                "field":"vendorExecution",
                "equals":"Individual"
            }
        },

        {
            "name": "vendorOccupation",
            "label": "Vendor's Occupation?" ,
