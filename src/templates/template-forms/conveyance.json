{
    "fields": [

        {
            "name": "date",
            "label": "Execution Date?",
            "type": "date",
            "required": "true"
        },

        {
          "name": "vendorCapacity",
          "label": "Select the Vendor's Capacity?",
          "type": "select",
          "options": [
            "Individual",
            "Corporate Body",
            "Infant",
            "Illiterate",
            "Attorney",
            "Family Property"
          ]
        },

        {
            "name": "vendorName",
            "label": "Vendor's Legal Name?",
            "type": "text",
        

            "dontShowIf": {
              "field": "vendorType",
              "equals": "no"
            }
        },

        {
            "name": "vendorOccupation",
            "label": "Vendor's Occupation?" ,
            "type": "occupation",
            "required": "true"
        },

        {
            "name": "vendorAddress",
            "label": "Vendor's Address?",
            "type": "textarea",
            "required": "true"
        },

        {
            "name": "purchaser",
            "label": "Purchaser's Legal Name?",
            "type": "text",
            "required": "true"
        },

        {
            "name": "purchaserOccupation",
            "label": "Purchaser's Occupation?" ,
            "type": "occupation",
            "required": "true"
        },

        {
            "name": "purchaserAddress",
            "label": "Purchaser's Address?",
            "type": "textarea",
            "required": "true"
        },

        {
            "name": "amount",
            "label": "Purchase Price?",
            "type": "currency",
            "required": "true"
        },

        {
            "name": "sourceOfTitle",
            "label": "How did the Vendor acquire the Property?",
            "type": "textarea",
            "required": "true"
        },

        {
            "name": "propertyDescription",
            "label": "How would you describe the Property?",
            "type": "property",
            "required": "true"
        },

        {
            "name": "surveyPlanDetails & surveyPlanNumber",
            "label": "Provide the survey plan number and details?",
            "type": "textarea",
            "required": "true"
        },

        {
            "name": "propertyAddress",
            "label": "What is the property's address?",
            "type": "address",
            "required": "true"
        },

        {
            "name": "surveyorParticulars",
            "label": "Provide the surveyor's name and address?",
            "type": "textarea",
            "required": "true"
        },

        {
            "name": "lawyerName",
            "label": "Lawyer's full name?",
            "type": "franking",
            "required": "true"
        },

        {
            "name": "lawFirm, lawFirmAddress & lawFirmEmail",
            "label": "Law firm name, address and email address?",
            "type": "franking",
            "required": "false"
        },

        {
          "name": "vendorExecution",
          "label": "Which best describes the Vendor?",
          "type": "select",
          "options": [
            "Individual",
            "Company",
            "Infant",
            "Illiterate",
            "Attorney",
            "Family Property"
          ],
          "required": true
        },
        
        {
          "name": "purchaserExecution",
          "label": "Which best describes the Purchaser?",
          "type": "select",
          "options": [
            "Individual",
            "Company",
            "Infant",
            "Illiterate",
            "Attorney",
            "Family Property"
          ],
          "required": true
        },

        {
          "name":"vendorIndividualName",
          "label":"Vendor's legal name",
          "showIf":{
              "field":"vendorExecution",
              "equals":"Individual"
          }
        },
        
        {
          "name":"vendorCompanyName",
          "label":"Company name",
          "showIf":{
              "field":"vendorExecution",
              "equals":"Company"
          }
        },
        
        {
          "name":"vendorInterpreterName",
          "label":"Interpreter's name",
          "showIf":{
              "field":"vendorExecution",
              "equals":"Illiterate"
          }
        },
        
        {
          "name":"vendorAttorneyName",
          "label":"Attorney's full name",
          "showIf":{
              "field":"vendorExecution",
              "equals":"Attorney"
          }
        },
        
        {
          "name":"familyHead",
          "label":"Family Head",
          "showIf":{
              "field":"vendorExecution",
              "equals":"Family Property"
          }
        }
    ]
}